    -- Function to run rainbow tool effect
    local function runRainbowToolEffect()
        local hue = 0
        local colorSpeed = 0.2

        local currentTool = nil
        local currentHandle = nil
        local originalHandleColor = nil

        local function findAndTrackTool()
            if LocalPlayer.Character then
                currentTool = LocalPlayer.Character:FindFirstChildOfClass("Tool")
                if currentTool then
                    currentHandle = currentTool:FindFirstChild("Handle")
                    if currentHandle and currentHandle:IsA("BasePart") then
                        if originalHandleColor == nil then
                            originalHandleColor = currentHandle.Color
                        end
                        return true
                    else
                        currentHandle = nil
                        originalHandleColor = nil
                    end
                else
                    currentTool = nil
                    currentHandle = nil
                    originalHandleColor = nil
                end
            end
            return false
        end

        LocalPlayer.CharacterAdded:Connect(function(character)
            character.ChildAdded:Connect(function(child)
                if child:IsA("Tool") then
                    task.wait(0.1)
                    findAndTrackTool()
                end
            end)
            character.ChildRemoved:Connect(function(child)
                if child == currentTool then
                    if originalHandleColor and currentHandle then
                        currentHandle.Color = originalHandleColor
                    end
                    currentTool = nil
                    currentHandle = nil
                    originalHandleColor = nil
                end
            end)
        end)

        local function cloneAndGiveRainbowTool()
            local cherryFolder = Workspace:WaitForChild("Cherry", 10)
            if not cherryFolder then
                warn("Rainbow Tool Effect: 'Cherry' folder not found in Workspace!")
                return
            end

            local sourceTool = cherryFolder:WaitForChild("Rainbow Sunflower Seed [X1]", 10)
            if not sourceTool or not sourceTool:IsA("Tool") then
                warn("Rainbow Tool Effect: 'Rainbow Sunflower Seed [X1]' tool not found!")
                return
            end

            local clonedTool = sourceTool:Clone()
            clonedTool.Parent = LocalPlayer.Backpack
        end

        findAndTrackTool()

        task.spawn(function()
            if not LocalPlayer.Character then
                LocalPlayer.CharacterAdded:Wait()
            end
            if not LocalPlayer:FindFirstChildOfClass("Backpack") then
                LocalPlayer:WaitForChild("Backpack", 10)
            end
            cloneAndGiveRainbowTool()
        end)

        RunService.RenderStepped:Connect(function(dt)
            if not currentHandle or not currentHandle.Parent then
                if not findAndTrackTool() then
                    return
                end
            end
            hue = (hue + dt * colorSpeed) % 1
            currentHandle.Color = Color3.fromHSV(hue, 1, 1)
        end)
    end

